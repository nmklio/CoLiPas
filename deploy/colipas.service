[Unit]
Description=CoLiPas cloud server management panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/colipas
EnvironmentFile=/opt/colipas/.env
Environment=NODE_ENV=production
Environment=RELEASE_DEPLOYMENT_MODE=systemd
ExecStart=/usr/bin/node build/server/index.js
Restart=on-failure
RestartSec=5
User=colipas
Group=colipas
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077
ExecStartPre=+/usr/bin/install -d -o colipas -g colipas -m 0700 /opt/colipas/.data
ReadWritePaths=/opt/colipas/.data

[Install]
WantedBy=multi-user.target
