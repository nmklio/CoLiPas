NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://colipas.example.com
CUSTOM_API_ALLOWED_HOSTS=httpbin.org,api.example.com,cmdb.internal.example.com
CUSTOM_API_TIMEOUT_MS=8000
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_TTL_HOURS=12
SESSION_MAX_ACTIVE=12
COLIPAS_DATA_DIR=.data
COLIPAS_METRIC_HISTORY_INTERVAL_MS=300000
COLIPAS_METRIC_HISTORY_RETENTION_MS=604800000
COLIPAS_METRIC_HISTORY_MAX_POINTS_PER_SERVER=2016
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret
RELEASE_VERIFY_TOKEN=
RELEASE_TARGET_NAME=production-systemd
RELEASE_CHANNEL=production
RELEASE_DEPLOYMENT_MODE=systemd
RELEASE_PUBLIC_URL=https://colipas.example.com
RELEASE_GIT_COMMIT=
RELEASE_ARTIFACT_ID=
RELEASE_DEPLOYED_AT=
