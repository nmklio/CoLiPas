{
  "name": "colipas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "smoke": "node scripts/smoke.mjs",
    "concurrency": "node scripts/concurrency-check.mjs",
    "test:large-user-simulation": "node scripts/large-user-simulation.mjs",
    "reset:admin": "node scripts/reset-admin-password.mjs",
    "secrets": "node scripts/secret-scan.mjs",
    "test": "npm run build && npm run secrets && node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ssh2": "^1.17.0",
    "topojson-client": "^3.1.0",
    "vite": "^7.2.7",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "playwright": "^1.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
